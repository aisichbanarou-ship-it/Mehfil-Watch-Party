rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'displayName', 'email'])
        && data.id is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.email is string;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['id', 'roomCode', 'roomName', 'hostUid', 'hostName'])
        && data.id is string
        && data.roomCode is string
        && data.roomCode.size() >= 4
        && data.roomName is string
        && data.roomName.size() > 0
        && data.hostUid is string
        && data.hostName is string;
    }

    function isValidParticipant(data) {
      return data.keys().hasAll(['id', 'roomId', 'displayName'])
        && data.id is string
        && data.roomId is string
        && data.displayName is string;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'roomId', 'senderUid', 'senderName', 'text'])
        && data.id is string
        && data.roomId is string
        && data.senderUid is string
        && data.senderName is string
        && data.text is string
        && data.text.size() > 0;
    }

    function isValidSignal(data) {
      return data.keys().hasAll(['id', 'roomId', 'fromUid', 'toUid', 'type', 'payload'])
        && data.id is string
        && data.roomId is string
        && data.fromUid is string
        && data.toUid is string
        && data.type is string
        && data.payload is string;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.hostUid == request.auth.uid
        && isValidRoom(request.resource.data);
      allow update: if isAuthenticated() && isValidRoom(request.resource.data);
      allow delete: if isAuthenticated()
        && resource.data.hostUid == request.auth.uid;

      match /participants/{participantId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated()
          && (request.auth.uid == participantId || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid)
          && isValidParticipant(request.resource.data);
        allow delete: if isAuthenticated()
          && (request.auth.uid == participantId || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid);
      }

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.senderUid == request.auth.uid
          && isValidChatMessage(request.resource.data);
        allow update, delete: if isAuthenticated()
          && (resource.data.senderUid == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid);
      }

      match /signals/{signalId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.fromUid == request.auth.uid
          && isValidSignal(request.resource.data);
        allow update, delete: if isAuthenticated()
          && (resource.data.fromUid == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid);
      }
    }
  }
}
